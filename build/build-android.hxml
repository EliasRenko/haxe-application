# Copy resources (using --macro to ensure execution)
--macro Sys.command("cmd", ["/c", ".\\bat\\copy-files.bat", "..\\haxe-native\\include", ".\\bin\\android\\include"])
--macro Sys.command("cmd", ["/c", ".\\bat\\copy-files.bat", "..\\haxe-native\\lib", ".\\bin\\android\\lib"])
--macro Sys.command("cmd", ["/c", ".\\bat\\copy-files.bat", ".\\res", ".\\bin\\android\\res"])
--macro Sys.command("cmd", ["/c", "if not exist bin\\android\\src mkdir bin\\android\\src"])
--macro Sys.command("cmd", ["/c", "copy ..\\haxe-native\\src\\glad.c bin\\android\\src\\glad.c"])
--macro Sys.command("cmd", ["/c", "copy ..\\haxe-native\\lib\\SDL3.dll bin\\android\\lib\\SDL3.dll"])
--macro include('hxcpp.android')

-cp src 
-cp test
-main Main
-cpp bin/android

-D HXCPP_DEBUGGER
-D HXCPP_M64
-D HXCPP_CPP11
-D HXCPP_NO_PCH
-D HXCPP_NO_PRECOMPILED_HEADERS
-D no-deprecation-warnings
-D HXCPP_ARM64
-D android
-D android-apk

-lib hxcpp-debug-server
-lib hxcpp
-lib haxe-native

-debug 
-dce std